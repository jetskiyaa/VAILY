PORT=3000
HOST=0.0.0.0
VAL_REGION=ap

# Comma-separated list of allowed browser origins in production.
# Example:
# ALLOWED_ORIGINS=https://vaily.example.com,https://www.vaily.example.com
ALLOWED_ORIGINS=

# Set to true when running behind a reverse proxy such as Nginx, Caddy, or a cloud platform.
TRUST_PROXY=false

# Optional alternate auth methods for server-side fallback.
# Leave blank unless you intentionally use them.
VAL_COOKIE_JSON=
VAL_SSID=
VAL_USER=
VAL_PASS=
